<Window x:Class="CrosshairOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair Overlay"
        Width="480" Height="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Topmost="True">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">

            <TextBlock Text="准心叠加层" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <GroupBox Header="准心样式" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <Label Content="样式"/>
                    <ComboBox ItemsSource="{Binding CrosshairStyles}"
                              SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="颜色与透明度" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="主颜色" Margin="0,6,0,2"/>
                        <TextBox Text="{Binding ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" Height="26" Margin="8,6,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="透明度" Margin="0,6,10,2"/>
                        <Slider Minimum="0.1" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding OpacityValue, Mode=TwoWay}" Width="200"/>
                        <TextBlock Text="{Binding OpacityValue, StringFormat={}{0:P0}}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="外观" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="线条粗细" Width="80"/>
                        <Slider Minimum="1" Maximum="10" SmallChange="1" LargeChange="2"
                                Value="{Binding ThicknessValue, Mode=TwoWay}" Width="160"/>
                        <TextBlock Text="{Binding ThicknessValue}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="长度" Width="80"/>
                        <Slider Minimum="4" Maximum="80" SmallChange="2" LargeChange="8"
                                Value="{Binding SizeValue, Mode=TwoWay}" Width="160"/>
                        <TextBlock Text="{Binding SizeValue}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="间距" Width="80"/>
                        <Slider Minimum="0" Maximum="30" SmallChange="1" LargeChange="5"
                                Value="{Binding GapValue, Mode=TwoWay}" Width="160"/>
                        <TextBlock Text="{Binding GapValue}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="圆点大小" Width="80"/>
                        <Slider Minimum="2" Maximum="30" SmallChange="1" LargeChange="5"
                                Value="{Binding DotSizeValue, Mode=TwoWay}" Width="160"/>
                        <TextBlock Text="{Binding DotSizeValue}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="轮廓描边" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox Content="启用描边" IsChecked="{Binding OutlineEnabled, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="描边颜色"/>
                        <TextBox Text="{Binding OutlineColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" Height="26" Margin="8,6,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="描边宽" Width="80"/>
                        <Slider Minimum="1" Maximum="5" SmallChange="1" LargeChange="1"
                                Value="{Binding OutlineThicknessValue, Mode=TwoWay}" Width="160"/>
                        <TextBlock Text="{Binding OutlineThicknessValue}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="快捷键" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock>
                        <Run Text="显示/隐藏准心: "/><Run Text="{Binding ToggleCrosshairHotkey}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="打开设置: "/><Run Text="{Binding OpenSettingsHotkey}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="系统" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox Content="开机自启" IsChecked="{Binding StartupEnabled, Mode=TwoWay}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="独占全屏兼容" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <CheckBox Content="使用管理员权限叠加层 (Real Overlay)"
                              IsChecked="{Binding UseExclusiveFullscreen, Mode=TwoWay}"/>
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="启用后需要"/>
                        <Run Text="管理员权限" FontWeight="Bold"/>
                        <Run Text="。可在大部分游戏的独占全屏模式下显示准心（不支持 Vulkan/OpenGL）。不启用时仅支持窗口化/无边框全屏。"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Game Bar Widget (独占全屏)" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap">
                        <Run Text="安装 Game Bar 准心套件后，按 "/><Run Text="Win+G" FontWeight="Bold"/>
                        <Run Text=" 打开 Game Bar，从 Widget 菜单打开「准心叠加层」并固定它。"/>
                        <Run Text="支持所有类型的独占全屏（包括 Vulkan），无需管理员权限。"/>
                    </TextBlock>
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="设置变更会自动同步到 Widget。"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                <Run Text="当前状态: "/>
                <Run Text="{Binding AdminStatusText, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="最小化到托盘" Command="{Binding MinimizeCommand}"
                        Width="140" Margin="0,0,10,0"/>
                <Button Content="退出" Command="{Binding ExitCommand}" Width="80"
                        Background="#E81123" Foreground="White"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
